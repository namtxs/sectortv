{
	"version": 3,
	"routes": [
		{
			"src": "/_app/immutable/.+",
			"headers": {
				"cache-control": "public, immutable, max-age=31536000"
			}
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/?(?:/__data.json)?$",
			"dest": "/"
		},
		{
			"src": "^/admin/?(?:/__data.json)?$",
			"dest": "/admin"
		},
		{
			"src": "^/admin/login/?(?:/__data.json)?$",
			"dest": "/admin/login"
		},
		{
			"src": "^/api/admin/auto/?(?:/__data.json)?$",
			"dest": "/api/admin/auto"
		},
		{
			"src": "^/api/admin/stats/?(?:/__data.json)?$",
			"dest": "/api/admin/stats"
		},
		{
			"src": "^/api/hls/?(?:/__data.json)?$",
			"dest": "/api/hls"
		},
		{
			"src": "^/api/presence/?(?:/__data.json)?$",
			"dest": "/api/presence"
		},
		{
			"src": "^/api/streams/?(?:/__data.json)?$",
			"dest": "/api/streams"
		},
		{
			"src": "^/api/track/?(?:/__data.json)?$",
			"dest": "/api/track"
		},
		{
			"src": "^/live/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/live/[name]"
		},
		{
			"src": "/.*",
			"dest": "/![-]/catchall"
		}
	],
	"overrides": {}
}