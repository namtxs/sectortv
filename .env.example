# Admin panel password (set this in production!)
ADMIN_PASSWORD=admin123

# Optional: extra secret for the session cookie token
# ADMIN_SECRET=change-me

# Persistent storage for manual channels (required on Vercel).
# Add a Redis/KV integration on Vercel and it injects these automatically.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional: Cloudflare Worker HLS proxy base URL. When set, CORS-blocked HLS
# streams play directly through the proxy instead of falling back to embeds.
# PROXY_BASE=https://sectortv-proxy.your-subdomain.workers.dev
